PORT=8080
ACK_TTL_HOURS=24
MESSAGE_TTL_HOURS=24
MAX_QUEUED_PER_DEVICE=500
CLEANUP_INTERVAL_MINUTES=60
RELAY_WS_URL=wss://d-chat-relay-server-production.up.railway.app
RELAY_HTTP_URL=https://d-chat-relay-server-production.up.railway.app

# Set automatically by Railway once a volume is attached to this
# service — do not set manually in production. Only useful to override
# for local testing without a real Railway volume.
# RAILWAY_VOLUME_MOUNT_PATH=/data